# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console -> OAuth client (Web application)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres connection string (Neon, Supabase, Railway...)
DATABASE_URL=

# Realtime server (defaults to the Render deployment)
NEXT_PUBLIC_WS_URL=wss://drawapp-backend-gzkk.onrender.com
